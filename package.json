{
  "name": "dsh-miniprogram-helper",
  "version": "0.2.0",
  "description": "DSH 插件：扫描、生成、注册、校验微信小程序页面与配置，并联动微信开发者工具出预览二维码",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wechat",
    "miniprogram",
    "小程序",
    "微信开发者工具"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/integration.test.ts",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leo666-cloud/dsh-miniprogram-helper.git"
  },
  "homepage": "https://github.com/leo666-cloud/dsh-miniprogram-helper#readme",
  "bugs": {
    "url": "https://github.com/leo666-cloud/dsh-miniprogram-helper/issues"
  }
}
